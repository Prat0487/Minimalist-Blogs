# Environment Variables

# Firebase (required for Google sign-in)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google AI / Genkit (optional — only needed for AI article summaries)
# Leave blank to disable AI summaries entirely. The key stays server-side only.
# GOOGLE_GENAI_API_KEY=

# Site URL (used for social sharing links)
NEXT_PUBLIC_SITE_URL=http://localhost:9002
